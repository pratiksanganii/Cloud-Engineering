# Terraform state — never commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Saved plan files
tfplan
*.tfplan

# Variable files that may contain secrets
*.tfvars.local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# CLI config
.terraformrc
terraform.rc
